{
  "info": {
    "name": "MedicalHistory_API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 Preparar Mascota para Historial",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "if (pm.response.code === 201) {",
              "    var jsonData = pm.response.json();",
              "    pm.collectionVariables.set(\"mh_pet_id\", jsonData.id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Mascota Historial\",\n  \"specie\": \"Perro\",\n  \"breed\": \"Criollo\",\n  \"age\": 2,\n  \"sex\": \"Macho\",\n  \"size\": \"Mediano\",\n  \"weight\": 12.0,\n  \"healthStatus\": \"Sano\",\n  \"adoptionStatus\": \"Disponible\",\n  \"description\": \"Mascota para MedicalHistory\",\n  \"admissionDate\": \"2023-01-01\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/pets",
          "host": ["{{baseUrl}}"],
          "path": ["pets"]
        }
      },
      "response": []
    },
    {
      "name": "Obtener Historiales Médicos",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Response is a valid JSON\", function () {",
              "    pm.response.to.be.json;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/medical-histories",
          "host": ["{{baseUrl}}"],
          "path": ["medical-histories"]
        }
      },
      "response": []
    },
    {
      "name": "Crear Historial Médico",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Response contains an ID\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.id).to.not.be.undefined;",
              "    pm.collectionVariables.set(\"mh_id\", jsonData.id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"vaccine\": \"Rabia, Parvovirus\",\n  \"diseases\": \"Gastroenteritis\",\n  \"treatment\": \"Antibióticos y suero\",\n  \"sterilized\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/pets/{{mh_pet_id}}/medical-histories",
          "host": ["{{baseUrl}}"],
          "path": ["pets", "{{mh_pet_id}}", "medical-histories"]
        }
      },
      "response": []
    },
    {
      "name": "Historial Médico por ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/medical-histories/{{mh_id}}",
          "host": ["{{baseUrl}}"],
          "path": ["medical-histories", "{{mh_id}}"]
        }
      },
      "response": []
    },
    {
      "name": "Actualizar Historial Médico",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Response contains the updated vaccine field\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('vaccine');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"vaccine\": \"Rabia, Parvovirus, Moquillo\",\n  \"diseases\": \"Gastroenteritis\",\n  \"treatment\": \"Tratamiento finalizado\",\n  \"sterilized\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/medical-histories/{{mh_id}}",
          "host": ["{{baseUrl}}"],
          "path": ["medical-histories", "{{mh_id}}"]
        }
      },
      "response": []
    },
    {
      "name": "Eliminar Historial Médico",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 204 No Content\", function () {",
              "    pm.response.to.have.status(204);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/medical-histories/{{mh_id}}",
          "host": ["{{baseUrl}}"],
          "path": ["medical-histories", "{{mh_id}}"]
        }
      },
      "response": []
    }
  ]
}