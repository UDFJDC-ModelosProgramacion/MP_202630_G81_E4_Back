{
  "info": {
    "name": "MedicalHistory_API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Obtener Historiales Médicos",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Response is a valid JSON\", function () {",
              "    pm.response.to.be.json;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/api/medical-histories",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "medical-histories"]
        }
      },
      "response": []
    },
    {
      "name": "Crear Historial Médico",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Response contains an ID\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.id).to.not.be.undefined;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"vaccine\": \"Rabia, Parvovirus\",\n  \"diseases\": \"Gastroenteritis\",\n  \"treatment\": \"Antibióticos y suero\",\n  \"sterilized\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://localhost:8080/api/pets/1/medical-histories",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "pets", "1", "medical-histories"]
        }
      },
      "response": []
    },
    {
      "name": "Historial Médico por ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/api/medical-histories/1",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "medical-histories", "1"]
        }
      },
      "response": []
    },
    {
      "name": "Actualizar Historial Médico",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Response contains the updated vaccine field\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('vaccine');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/api/medical-histories/1",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "medical-histories", "1"]
        }
      },
      "response": []
    },
    {
      "name": "Eliminar Historial Médico",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 204 No Content\", function () {",
              "    pm.response.to.have.status(204);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/api/medical-histories/1",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "medical-histories", "1"]
        }
      },
      "response": []
    }
  ]
}