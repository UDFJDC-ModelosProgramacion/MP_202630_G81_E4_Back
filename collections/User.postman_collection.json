  "item": [
    {
      "name": "Crear un usuario",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var data = pm.response.json();",
              "pm.globals.set(\"usr_id_1\", data.id);",
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"La contraseña no se devuelve en la respuesta\", function () {",
              "    pm.expect(data.password).to.be.undefined;",
              "});",
              "pm.test(\"Devuelve los datos del usuario creado\", function () {",
              "    pm.expect(data.email).to.eql(\"ana.torres@example.com\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/users",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n    \"name\": \"Ana Torres\",\n    \"email\": \"ana.torres@example.com\",\n    \"phone\": \"3001112233\",\n    \"address\": \"Calle 10 # 5-20\",\n    \"password\": \"clave123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
