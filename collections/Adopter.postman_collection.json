  "item": [
    {
      "name": "Crear un adoptante",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var data = pm.response.json();",
              "pm.globals.set(\"adp_coll_id_1\", data.id);",
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Devuelve los datos del adoptante creado\", function () {",
              "    pm.expect(data.address).to.eql(\"Carrera 7 # 40-10\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/adopters",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "adopters"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n    \"address\": \"Carrera 7 # 40-10\",\n    \"phone\": \"3105556677\",\n    \"occupation\": \"Ingeniera\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
