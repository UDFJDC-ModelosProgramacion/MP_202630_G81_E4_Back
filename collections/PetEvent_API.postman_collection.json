{
  "info": {
    "name": "PetEvent_API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 Preparar Mascota para Evento",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "if (pm.response.code === 201) {",
              "    var jsonData = pm.response.json();",
              "    pm.collectionVariables.set(\"pe_pet_id\", jsonData.id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Mascota Evento\",\n  \"specie\": \"Perro\",\n  \"breed\": \"Criollo\",\n  \"age\": 2,\n  \"sex\": \"Macho\",\n  \"size\": \"Mediano\",\n  \"weight\": 14.0,\n  \"healthStatus\": \"Sano\",\n  \"adoptionStatus\": \"Disponible\",\n  \"description\": \"Mascota para PetEvent\",\n  \"admissionDate\": \"2023-01-01\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/pets",
          "host": ["{{baseUrl}}"],
          "path": ["pets"]
        }
      },
      "response": []
    },
    {
      "name": "Obtener Eventos",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Response is a valid JSON\", function () {",
              "    pm.response.to.be.json;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/pet-events",
          "host": ["{{baseUrl}}"],
          "path": ["pet-events"]
        }
      },
      "response": []
    },
    {
      "name": "Crear Evento",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Response contains an ID\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.id).to.not.be.undefined;",
              "    pm.collectionVariables.set(\"pe_event_id\", jsonData.id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"type\": \"Reporte Médico\",\n  \"date\": \"2023-05-10\",\n  \"description\": \"Desparasitación realizada exitosamente.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/pets/{{pe_pet_id}}/events",
          "host": ["{{baseUrl}}"],
          "path": ["pets", "{{pe_pet_id}}", "events"]
        }
      },
      "response": []
    },
    {
      "name": "Evento por ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/pet-events/{{pe_event_id}}",
          "host": ["{{baseUrl}}"],
          "path": ["pet-events", "{{pe_event_id}}"]
        }
      },
      "response": []
    },
    {
      "name": "Actualizar Evento",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Response contains the updated type\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('type');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"type\": \"Reporte Médico\",\n  \"date\": \"2023-05-11\",\n  \"description\": \"Control general actualizado.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/pet-events/{{pe_event_id}}",
          "host": ["{{baseUrl}}"],
          "path": ["pet-events", "{{pe_event_id}}"]
        }
      },
      "response": []
    },
    {
      "name": "Eliminar Evento",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 204 No Content\", function () {",
              "    pm.response.to.have.status(204);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/pet-events/{{pe_event_id}}",
          "host": ["{{baseUrl}}"],
          "path": ["pet-events", "{{pe_event_id}}"]
        }
      },
      "response": []
    }
  ]
}