{
  "info": {
    "_postman_id": "81b1db43-6f72-4ae2-8679-7a69fba7707f",
    "name": "AdoptionRequest",
    "description": "Colección para el recurso AdoptionRequest. Representa las solicitudes de adopción (estados PENDIENTE, APROBADO, CANCELADO) hechas por un adoptante sobre una mascota.\n\nPruebas corregidas: los datos previos que antes se creaban con pm.sendRequest en pre-request ahora son requests explícitos y secuenciales. Esto evita que la petición principal se ejecute antes de que existan sus datos de prueba.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "57861283",
    "_collection_link": "https://go.postman.co/collection/57861283-81b1db43-6f72-4ae2-8679-7a69fba7707f?source=collection_link"
  },
  "item": [
    {
      "name": "01 - Preparar adoptante",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const runId = Date.now().toString();",
              "pm.collectionVariables.set(\"run_id\", runId);",
              "pm.collectionVariables.set(\"adopter_phone\", runId.slice(-10));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Adopter creado - status 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "if (pm.response.code === 201) {",
              "    const data = pm.response.json();",
              "    pm.expect(data.id).to.exist;",
              "    pm.collectionVariables.set(\"adopter_id\", data.id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"address\": \"Calle 123 # 45-67\",\n    \"phone\": \"{{adopter_phone}}\",\n    \"occupation\": \"Ingeniero\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/adopters",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "adopters"
          ]
        }
      },
      "response": []
    },
